        "flow",
        "chat",
        "terminal"
      ]
    },
    {
      "id": "availability-limit",
      "timeRangeSeconds": {
        "start": 19,
        "end": 25
      },
      "purpose": "State access conditions, limitations, and what remains unchanged.",
      "sceneCount": 1,
      "recommendedSceneTypes": [
        "list",
        "compare"
      ]
    },
    {
      "id": "who-cares",
      "timeRangeSeconds": {
        "start": 25,
        "end": 30
      },
      "purpose": "Identify who should care and why.",
      "sceneCount": 1,
