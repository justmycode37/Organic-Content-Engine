{
  "schemaVersion": 1,
  "id": "what-changed",
  "name": "WHAT CHANGED — one release, one consequence",
  "evidence": {
    "label": "hypothesis",
    "basis": "Inference",
    "source": "output/ecosystem/04-viral-strategies.md §12",
    "note": "Original PATCH NOTES adaptation to test. Zero new Instagram examples qualified under the report's strict viral-reference gate; this format is not validated. The length band is an initial production/test band, not a proven algorithm sweet spot.",
    "rationale": "Timely, recipient-specific utility is a proposed reason to test this format; no result is established."
  },
  "lengthBandSeconds": {
    "min": 22,
    "max": 35,
    "basis": "initial production/test band"
  },
  "primaryMetric": "Shares/accounts reached",
  "diagnostics": [
    "Average watch time"
  ],
  "evidenceRequirements": [
    "Verify whether the change is announced, available, generally shipped, or limited to a preview.",
    "Name the old workflow and the precise new step; do not imply a broader job replacement.",
    "Check date, eligibility, price, geography, and rollout caveats at publication."
  ],
  "recommendedStyles": [
    "breaking",
    "patch",
    "system",
    "bigidea"
  ],
  "beatStructure": [
    {
      "id": "old-new-contrast",
      "timeRangeSeconds": {
        "start": 0,
        "end": 2
      },
      "purpose": "Show the old and new state together.",
      "sceneCount": 1,
      "recommendedSceneTypes": [
        "compare",
        "title"
      ]
    },
    {
      "id": "shipped-change",
      "timeRangeSeconds": {
        "start": 2,
        "end": 7
      },
