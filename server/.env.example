# Copy to server/.env (chmod 600). Never commit real values. Blank = unset.

NODE_ENV=development
HOST=127.0.0.1
# The frontend's dev proxy targets http://localhost:3001 by default.
PORT=3001

# Required when NODE_ENV=production or HOST is not loopback. Min 32 chars.
#   openssl rand -hex 32
API_TOKEN=
# Comma-separated browser origins allowed to call the API.
# Default outside production: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=
# Defaults to true in production.
COOKIE_SECURE=

# Default: server/data/engine.db
DATABASE_PATH=

# dry_run (default) never touches the network. live posts for real, and only
# on platforms with complete credentials below.
PUBLISH_MODE=dry_run
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
PUBLISH_HTTP_TIMEOUT_MS=20000

# template (offline, always needs human review) | anthropic
CONTENT_GENERATOR=template
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Direct adapters (text-only) ---
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_SERVICE_URL=https://bsky.social

MASTODON_INSTANCE_URL=
MASTODON_ACCESS_TOKEN=
MASTODON_MAX_CHARS=500

LINKEDIN_ACCESS_TOKEN=
# urn:li:person:<id> or urn:li:organization:<id>
LINKEDIN_AUTHOR_URN=
# YYYYMM. No default on purpose: LinkedIn sunsets versions.
LINKEDIN_API_VERSION=

# OAuth 2.0 user-context token with tweet.write. Not refreshed by this server.
X_USER_ACCESS_TOKEN=

# --- External publishing gateway (see docs/backend.md for the protocol) ---
PUBLISHING_GATEWAY_URL=
PUBLISHING_GATEWAY_TOKEN=
# Platforms to route through it, e.g. instagram,tiktok. Overrides direct adapters.
PUBLISHING_GATEWAY_PLATFORMS=
