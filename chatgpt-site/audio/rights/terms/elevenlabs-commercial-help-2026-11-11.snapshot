-nowrap border-0 p-0" data-fern-style="margin:-1px"><ul><li><a href="/docs/help-center/legal/can-i-publish-the-content-i-generate-on-the-platform" tabindex="-1" aria-current="true">English</a></li><li><a href="/docs/nl/help-center/legal/can-i-publish-the-content-i-generate-on-the-platform" tabindex="-1">Nederlands</a></li><li><a href="/docs/sv/help-center/legal/can-i-publish-the-content-i-generate-on-the-platform" tabindex="-1">Svenska</a></li><li><a href="/docs/it/help-center/legal/can-i-publish-the-content-i-generate-on-the-platform" tabindex="-1">Italiano</a></li><li><a href="/docs/ko/help-center/legal/can-i-publish-the-content-i-generate-on-the-platform" tabindex="-1">한국어</a></li><li><a href="/docs/fr/help-center/legal/can-i-publish-the-content-i-generate-on-the-platform" tabindex="-1">Français</a></li><li><a href="/docs/zh/help-center/legal/can-i-publish-the-content-i-generate-on-the-platform" tabindex="-1">中文</a></li><li><a href="/docs/pl/help-center/legal/can-i-publish-the-content-i-generate-on-the-platform" tabindex="-1">Polski</a></li><li><a href="/docs/pt/help-center/legal/can-i-publish-the-content-i-generate-on-the-platform" tabindex="-1">Português</a></li><li><a href="/docs/es/help-center/legal/can-i-publish-the-content-i-generate-on-the-platform" tabindex="-1">Español</a></li><li><a href="/docs/hi/help-center/legal/can-i-publish-the-content-i-generate-on-the-platform" tabindex="-1">हिन्दी</a></li><li><a href="/docs/de/help-center/legal/can-i-publish-the-content-i-generate-on-the-platform" tabindex="-1">Deutsch</a></li><li><a href="/docs/ja/help-center/legal/can-i-publish-the-content-i-generate-on-the-platform" tabindex="-1">日本語</a></li></ul></nav><script>
        (function () {
          // Runs on the initial load AND on every view-transition swap: Astro
          // re-inserts the `transition:persist`ed sidebar into the new document,
          // and re-inserting a scroll container resets its scrollTop to 0, so we
          // restore the position from sessionStorage before paint to avoid a
          // visible jump. The companion scroll listener below keeps that stored
          // value in lockstep with the live scroll (the hydrated build did this
          // via React); without it the restored value drifts stale and the
          // sidebar jumps to the wrong offset on navigation.
          try {
            var KEY = "fern-sidebar-scroll-position";
            var container = document.getElementById("fern-sidebar-scroll-area");
            if (!container) { return; }
            var storedRaw = window.sessionStorage.getItem(KEY);
            var stored = storedRaw != null ? parseInt(storedRaw, 10) : 0;
            if (Number.isFinite(stored) && stored > 0) {
              container.scrollTop = stored;
              return;
            }
            var active = container.querySelector('.fern-sidebar-link[data-state="active"]');
            if (!active) { return; }
            var cRect = container.getBoundingClientRect();
            var aRect = active.getBoundingClientRect();
            var isAbove = aRect.top < cRect.top;
            var isBelow = aRect.bottom > cRect.bottom;
            if (!isAbove && !isBelow) { return; }
            var offset = aRect.top - cRect.top + container.scrollTop;
            var target = Math.max(0, Math.round(offset - container.clientHeight / 3));
            container.scrollTop = target;
            if (target > 0) {
              window.sessionStorage.setItem(KEY, String(target));
            }
          } catch (e) { /* sessionStorage/layout unavailable — fall back to the hydration-time scroll */ }
        })();
      </script></main><!-- Footer (matches AbstractDefaultDocs footer) --><footer id="fern-footer" class="width-before-scroll-bar"></footer></div><div data-astro-transition-persist="fern-mobile-menu-portal-en-sidebar:|||fbc7cf66bf420946368aee9660786f4b71ff4c53911258d3d966536b44d031bd" id="fern-mobile-menu-portal"></div><astro-island uid="1n7Sc8" component-url="/docs/_astro/MobileMenuShell.BIYhuFkw.js" component-export="default" renderer-url="/docs/_astro/client.6CXocn7l.js" props="{&quot;navAssetUrl&quot;:[0,&quot;/docs/_fern-files/_nav/5f559770c118c273.json&quot;],&quot;sidebarRootNodeId&quot;:[0,&quot;sidebar:|||fbc7cf66bf420946368aee9660786f4b71ff4c53911258d3d966536b44d031bd&quot;],&quot;initialNodeId&quot;:[0,&quot;page:docs/help-center/legal/can-i-publish-the-content-i-generate-on-the-platform&quot;],&quot;visibleNodeIds&quot;:[1,[[0,&quot;root&quot;],[0,&quot;unversioned:root&quot;],[0,&quot;tabbed:|||6b88a76a72244d4c316594c7444a921b82ed36a076fcc4f1ecc0e7d7ec9f9308&quot;],[0,&quot;tab:docs/help-center&quot;],[0,&quot;sidebar:|||fbc7cf66bf420946368aee9660786f4b71ff4c53911258d3d966536b44d031bd&quot;],[0,&quot;sidebar-group:section:docs/help-center/legal&quot;],[0,&quot;section:docs/help-center/legal&quot;],[0,&quot;page:docs/help-center/legal/can-i-publish-the-content-i-generate-on-the-platform&quot;]]],&quot;currentVariantId&quot;:[0,null],&quot;basepath&quot;:[0,&quot;/docs&quot;],&quot;currentLocale&quot;:[0],&quot;hasLight&quot;:[0,true],&quot;hasDark&quot;:[0,true],&quot;productSwitcher&quot;:[0,null],&quot;versionSwitcher&quot;:[0,null],&quot;navbarLinks&quot;:[1,[[0,{&quot;type&quot;:[0,&quot;dropdown&quot;],&quot;url&quot;:[0,&quot;&quot;],&quot;text&quot;:[0,&quot;Connect&quot;],&quot;icon&quot;:[0],&quot;rightIcon&quot;:[0],&quot;rounded&quot;:[0],&quot;target&quot;:[0],&quot;links&quot;:[1,[[0,{&quot;url&quot;:[0,&quot;https://discord.gg/elevenlabs&quot;],&quot;text&quot;:[0,&quot;Discord&quot;],&quot;icon&quot;:[0,&quot;fa-brands fa-discord&quot;],&q