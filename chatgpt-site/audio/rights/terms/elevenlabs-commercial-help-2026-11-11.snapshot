&quot;:[0],&quot;featureFlags&quot;:[0],&quot;pointsTo&quot;:[0,&quot;docs/help-center/help-center-directory&quot;],&quot;child&quot;:[0,{&quot;type&quot;:[0,&quot;sidebarRoot&quot;],&quot;id&quot;:[0,&quot;sidebar:|||fbc7cf66bf420946368aee9660786f4b71ff4c53911258d3d966536b44d031bd&quot;],&quot;collapsed&quot;:[0],&quot;children&quot;:[1,[]]}]}]]],&quot;tabsPlacement&quot;:[0,&quot;HEADER&quot;],&quot;currentTabId&quot;:[0,&quot;tab:docs/help-center&quot;],&quot;tabPreResolvedIconSvgs&quot;:[0,{}],&quot;tabIconFallback&quot;:[0,{&quot;/docs/_fern-files/_icons/solid/book.svg&quot;:[0,&quot;&lt;svg data-prefix=\&quot;fas\&quot; data-icon=\&quot;book\&quot; class=\&quot;svg-inline--fa fa-book\&quot; role=\&quot;img\&quot; viewBox=\&quot;0 0 448 512\&quot; aria-hidden=\&quot;true\&quot;&gt;&lt;path fill=\&quot;currentColor\&quot; d=\&quot;M384 512L96 512c-53 0-96-43-96-96L0 96C0 43 43 0 96 0L400 0c26.5 0 48 21.5 48 48l0 288c0 20.9-13.4 38.7-32 45.3l0 66.7c17.7 0 32 14.3 32 32s-14.3 32-32 32l-32 0zM96 384c-17.7 0-32 14.3-32 32s14.3 32 32 32l256 0 0-64-256 0zm32-232c0 13.3 10.7 24 24 24l176 0c13.3 0 24-10.7 24-24s-10.7-24-24-24l-176 0c-13.3 0-24 10.7-24 24zm24 72c-13.3 0-24 10.7-24 24s10.7 24 24 24l176 0c13.3 0 24-10.7 24-24s-10.7-24-24-24l-176 0z\&quot; /&gt;&lt;/svg&gt;&quot;]}],&quot;tabFiles&quot;:[0,{}],&quot;authButton&quot;:[0,{&quot;returnToQueryParam&quot;:[0,&quot;returnTo&quot;],&quot;href&quot;:[0,&quot;/~login?returnTo=%2Fdocs%2Fhelp-center%2Flegal%2Fcan-i-publish-the-content-i-generate-on-the-platform&quot;]}],&quot;data-astro-transition-persist&quot;:[0,&quot;fern-mobile-menu-en-sidebar:|||fbc7cf66bf420946368aee9660786f4b71ff4c53911258d3d966536b44d031bd&quot;]}" ssr client="only" opts="{&quot;name&quot;:&quot;MobileMenuShell&quot;,&quot;value&quot;:&quot;react&quot;}" data-astro-transition-persist="fern-mobile-menu-en-sidebar:|||fbc7cf66bf420946368aee9660786f4b71ff4c53911258d3d966536b44d031bd"></astro-island><astro-island uid="Z2vLdcm" component-url="/docs/_astro/SearchDialogShell.CYDhBk4V.js" component-export="default" renderer-url="/docs/_astro/client.6CXocn7l.js" props="{&quot;domain&quot;:[0,&quot;elevenlabs.io&quot;],&quot;siteHosts&quot;:[1,[[0,&quot;elevenlabs.docs.buildwithfern.com&quot;],[0,&quot;elevenlabs.io&quot;]]],&quot;basepath&quot;:[0,&quot;/docs&quot;],&quot;lang&quot;:[0,&quot;en&quot;],&quot;searchLocale&quot;:[0,&quot;en&quot;],&quot;hasLight&quot;:[0,true],&quot;hasDark&quot;:[0,true],&quot;askAiEnabled&quot;:[0,false],&quot;localDev&quot;:[0,false]}" ssr client="only" opts="{&quot;name&quot;:&quot;SearchDialogShell&quot;,&quot;value&quot;:&quot;react&quot;}"></astro-island><div data-astro-transition-persist="fern-custom-js-holder" id="fern-custom-js-holder"></div><script data-fern-custom-script>(function(){var c=document.currentScript;var s=document.createElement("script");s.setAttribute("data-fern-custom-script","");s.text="(function(){const bodyScripts = [{\"src\":\"https://elevenlabs.io/player/audioNativeHelper.js\",\"strategy\":\"lazyOnload\"},{\"src\":\"/docs/_fern-files/elevenlabs.docs.buildwithfern.com/d79520411e2261ace07cfab8ee53b6ea364214322253c745dba7acc35ff342c8/assets/scripts/widget.js\",\"strategy\":\"lazyOnload\"},{\"src\":\"/docs/_fern-files/elevenlabs.docs.buildwithfern.com/3d76a72196c1b8e43cc6a989b28d40e6428b542a3ee363f8a07472382d01afcc/assets/scripts/audio-player.js\",\"strategy\":\"lazyOnload\"},{\"src\":\"/docs/_fern-files/elevenlabs.docs.buildwithfern.com/5134a52dcf1861899a438d2585db872754836a8ccbb933f17626f2ccc69dd7ef/assets/scripts/accordion-single-expand.js\",\"strategy\":\"lazyOnload\"},{\"src\":\"/docs/_fern-files/elevenlabs.docs.buildwithfern.com/f9293ea6e94ee0e33352418bd61475e4dca40634ae1a4d4f743cdf4676e214d5/assets/scripts/api-signup-link.js\",\"strategy\":\"lazyOnload\"},{\"src\":\"/docs/_fern-files/elevenlabs.docs.buildwithfern.com/3f00e6ff6d1d8caf871bd90d1631da009a25f7db425481e435834b3fd9ff0f7f/assets/scripts/tts-cta-experiment.js\",\"strategy\":\"lazyOnload\"}];\n\n        (function () {\n          // Inject each docs-configured script once. `src` scripts already on\n          // the page (data-fern-custom-js) are left in place — the docs scripts\n          // handle SPA re-init themselves; inline scripts run once.\n          //\n          // Injected elements go into #fern-custom-js-holder — a\n          // `transition:persist` container — rather than document.body. Without\n          // it the injected \u003cscript> was removed by every body swap, so the\n          // dedup below lost the element and re-injected it on every\n          // `astro:page-load`, re-executing the script each navigation (a\n          // classic script with top-level `const`/`let` bindings then throws\n          // \"Identifier ... has already been declared\" and its re-render\n          // observers never re-register).\n          //\n          // Persisting the element is not enough on its own: after each swap the\n          // ClientRouter re-runs every \u003cscript> in the document that is not\n          // marked `data-astro-exec` (cloning + replacing the element), which\n          // would execute the persisted script a second time. Mark injected\n          // scripts as already executed so the router leaves them alone. Must be\n          // set BEFORE the element is inserted — an unstamped node in the\n          // document is exactly what the router clones.\n          function markExecuted(el) {\n            el.setAttribute(\"data-astro-exec\", \"\");\n          }\n          function injectFernCustomScripts() {\n            const holder = document.getElementById(\"fern-custom-js-holder\") || document.body;\n            for (const s of bodyScripts) {\n              if (s.src) {\n                if (document.querySelector('script[data-fern-custom-js=\"' + s.src + '\"]')) { continue; }\n                const el = document.createElement(\"script\");\n                el.src = s.src;\n                // Script-inserted scripts ignore `defer` and default to async, so\n                // they ran in download order. Classic scripts share one global\n                // lexical scope, so order matters: two bundles that both declare\n                // a top-level `const`/`let` of the same name throw \"Identifier\n                // ... has already been declared\" in whichever runs second.\n                // `async = false` runs them in docs.yml order, like next/script.\n                el.async = false;\n                el.setAttribute(\"data-fern-custom-js\", s.src);\n                if (s.integrity) { el.integrity = s.integrity; el.crossOrigin = \"anonymous\"; }\n                markExecuted(el);\n                holder.appendChild(el);\n              } else if (s.inline) {\n                if (document.querySelector(\"script[data-fern-custom-inline='\" + encodeURIComponent(s.inline) + \"']\")) { continue; }\n                const el = document.createElement(\"script\");\n                el.textContent = s.inline;\n                el.setAttribute(\"data-fern-custom-inline\", encodeURIComponent(s.inline));\n                markExecuted(el);\n                holder.appendChild(el);\n              }\n            }\n          }\n          if (!window.__fernCustomScriptsBound) {\n            window.__fernCustomScriptsBound = true;\n            // Bind per-page on each `astro:page-load` (initial load + every\n            // ClientRouter navigation) and inject once the page's React islands\n            // — MDX content, header, footer, endpoint reference — have hydrated.\n            // A customer script that edits their server-rendered DOM before\n            // that (renaming \"Copy page\", removing #builtwithfern, translating\n            // the footer prompt) makes React see markup it didn't render\n            // (React #418), re-render the island and discard the script's\n            // edits. next/script only runs these after the whole Next page has\n            // hydrated, so this page hydrates every island up front\n            // (`\u003chtml data-fern-hydrate-all>` turns `client:lazy` into\n            // hydrate-on-idle; `client:deferred` already is) and waits until\n            // every such island carries `data-fern-hydrated`, which the patched\n            // @astrojs/react client stamps from a passive effect once React has\n            // committed the island (Astro drops the `ssr` attribute as soon as\n            // hydrateRoot() returns, but under startTransition React commits\n            // the time-sliced hydration later — a script run in between still\n            // edits DOM React is about to check). A `client:visible` /\n            // `client:media` island that never comes up is not waited on, so\n            // it can't hold the scripts to the timeout — bounded by a safety\n            // timeout longer than the directives' idle timeout in case an\n            // island never hydrates (e.g. a failed chunk). An island's root\n            // commits while a Suspense boundary inside it (MDX module gate,\n            // lazy component group) still awaits its import(); React hydrates\n            // that subtree in a later commit, so `\u003chtml data-fern-mdx-pending>`\n            // (set by state/mdxSuspensePending while such a load is in flight)\n            // holds the scripts as well. The double-rAF +\n            // 50ms tail is safe because injection is idempotent (deduped by\n            // data-fern-custom-js); `injected` guards against a second run.\n            const ISLAND_PENDING = ['load', 'idle', 'only', 'deferred', 'lazy']\n              .map(function (client) { return 'astro-island[client=\"' + client + '\"]:not([data-fern-hydrated])'; })\n              .join(', ');\n            const ISLAND_TIMEOUT_MS = 5000;\n            function hydrationPending() {\n              return document.querySelector(ISLAND_PENDING) != null\n                || document.documentElement.hasAttribute(\"data-fern-mdx-pending\");\n            }\n            function whenIslandsHydrated(callback) {\n              if (!hydrationPending()) {\n                callback();\n                return;\n              }\n              let done = false;\n              const observer = new MutationObserver(check);\n              const timer = setTimeout(finish, ISLAND_TIMEOUT_MS);\n              observer.observe(document.documentElement, {\n                attributes: true,\n                attributeFilter: [\"data-fern-hydrated\", \"data-fern-mdx-pending\"],\n                subtree: true\n              });\n              function check() {\n                if (!hydrationPending()) { finish(); }\n              }\n              function finish() {\n                if (done) { return; }\n                done = true;\n                clearTimeout(timer);\n                observer.disconnect();\n                callback();\n              }\n            }\n            document.addEventListener(\"astro:page-load\", function () {\n              let injected = false;\n              function injectOnce() {\n                if (injected) { return; }\n                injected = true;\n                injectFernCustomScripts();\n              }\n              whenIslandsHydrated(function () {\n                requestAnimationFrame(function () {\n                  requestAnimationFrame(function () {\n                    setTimeout(injectOnce, 50);\n                  });\n                });\n              });\n            });\n          }\n        })();\n      })();";s.async=false;(c&&c.parentNode?c.parentNode:document.head).insertBefore(s,c);})();</script><div data-astro-transition-persist="fern-preview-masquerade" class="contents"><template id="fern-preview-masquerade"><astro-island uid="WR8mr" component-url="/docs/_astro/PreviewMasqueradeIsland.2Hu6hBP-.js" component-export="default" renderer-url="/docs/_astro/client.6CXocn7l.js" props="{&quot;allRoles&quot;:[1,[[0,&quot;everyone&quot;],[0,&quot;agents_onboarding_developer&quot;],[0,&quot;admins&quot;],[0,&quot;productions_public_api&quot;],[0,&quot;private_deployment_developer&quot;],[0,&quot;live_dubbing_access&quot;],[0,&quot;dubbing_resource_api_docs&quot;]]],&quot;homeHref&quot;:[0,&quot;/docs/overview/intro&quot;]}" ssr client="only" opts="{&quot;name&quot;:&quot;PreviewMasqueradeIsland&quot;,&quot;value&quot;:&quot;react&quot;}"></astro-island></template></div><script data-astro-rerun>(function(){var h=location.hostname;var t=document.getElementById("fern-preview-masquerade");if(!t||!(h==="localhost"||h==="127.0.0.1"||h.endsWith(".workers.dev")||h.endsWith(".docs.dev.buildwithfern.com")||(h.endsWith(".docs.buildwithfern.com")&&/^[^.]+-preview-[^.]/.test(h))))return;if(document.querySelector('astro-island[component-url*="PreviewMasquerade"]')){t.remove();return;}t.replaceWith(t.content);})();</script><astro-island uid="Z1cFEs2" prefix="r21" component-url="/docs/_astro/AnalyticsIsland.ehO6In4v.js" component-export="default" renderer-url="/docs/_astro/client.6CXocn7l.js" props="{&quot;analyticsConfig&quot;:[0,{&quot;posthog&quot;:[0,{&quot;apiKey&quot;:[0,&quot;phc_KQDh5IkRcTsPOoUtwmVxoATdOqNYCo0vTdwE77aNOQv&quot;],&quot;endpoint&quot;:[0,&quot;https://elevenlabs.io/hog&quot;]}],&quot;ga4&quot;:[0,{&quot;measurementId&quot;:[0,&quot;G-82RG1PXYVW&quot;]}]}],&quot;basepath&quot;:[0,&quot;/docs&quot;],&quot;siteHosts&quot;:[1,[[0,&quot;elevenlabs.docs.buildwithfern.com&quot;],[0,&quot;elevenlabs.io&quot;]]],&quot;siteCookieDomains&quot;:[1,[[0,&quot;buildwithfern.com&quot;],[0,&quot;elevenlabs.io&quot;]]]}" ssr client="load" opts="{&quot;name&quot;:&quot;AnalyticsIsland&quot;,&quot;value&quot;:true}" await-children><!--$--><!--/$--><!--astro:end--></astro-island><!--/email_off--></body></html>