ve" data-radix-collection-item=""><span class="truncate">API reference</span></a><a href="/docs/changelog" id="changelog:docs/changelog" role="tab" aria-selected="false" data-state="inactive" data-radix-collection-item=""><span class="truncate">Changelog</span></a><a href="/docs/help-center/help-center-directory" id="tab:docs/help-center" role="tab" aria-selected="true" data-state="active" data-radix-collection-item=""><span class="truncate">Help Center</span></a></div></div><!--astro:end--></astro-island></div></div></header><script>
      (function () {
        // Only write when the value changes: every write restyles the whole
        // document. The ResizeObserver path reads `contentRect` after layout
        // instead of forcing a synchronous layout before first paint.
        function applyHeaderHeight(height) {
          var value = height + "px";
          if (document.documentElement.style.getPropertyValue("--header-height") !== value) {
            document.documentElement.style.setProperty("--header-height", value);
          }
        }
        function syncHeaderHeight() {
          var header = document.getElementById("fern-header");
          if (header) {
            var style = window.getComputedStyle(header);
            applyHeaderHeight(header.clientHeight - parseFloat(style.paddingTop) - parseFloat(style.paddingBottom));
          }
        }
        var ro;
        function setup() {
          var header = document.getElementById("fern-header");
          if (header && "ResizeObserver" in window) {
            if (ro) { ro.disconnect(); }
            ro = new ResizeObserver(function (entries) {
              var entry = entries[entries.length - 1];
              if (entry) { applyHeaderHeight(entry.contentRect.height); }
            });
            ro.observe(header);
          } else {
            (window.requestAnimationFrame || window.setTimeout)(syncHeaderHeight);
          }
        }
        setup();
        if (!window.__fernHeaderHeightBound) {
          window.__fernHeaderHeightBound = true;
          document.addEventListener("astro:page-load", setup);
          // The swap replaces <html>'s attributes (including the inline style
          // holding the synced value), so carry it over to the incoming document
          // or the header/main/sidebar briefly snap to the stylesheet fallback.
          document.addEventListener("astro:before-swap", function (event) {
            var current = document.documentElement.style.getPropertyValue("--header-height");
            if (current && event.newDocument) {
              event.newDocument.documentElement.style.setProperty("--header-height", current);
            }
          });
        }
      })();
    </script><!-- Main (matches MainElement) --><main class="fern-main relative z-0 flex transition-all duration-500 ease-out mt-(--header-height)" data-theme="default" data-fern-active-slugs="docs/help-center/legal/can-i-publish-the-content-i-generate-on-the-platform" data-fern-style="transition: max-width 500ms ease-out"><a href="#fern-sidebar" class="sr-only max-lg:hidden focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:border focus:border-border-concealed focus:bg-(color:--background) focus:px-4 focus:py-2 focus:text-body focus:no-underline focus:shadow-md">Skip to navigation</a><aside id="fern-sidebar-spacer" data-state="fixed"></aside><!-- Page content is an Astro slot, so the shared layout wrappers are mirrored here while their stateful components are reused directly. --><aside id="fern-toc"></aside><div class="fern-layout-content-wrapper min-w-0 flex-1"><div class="fern-layout-guide transition-all duration-500 ease-out"><astro-island uid="frFmt" prefix="r16" component-url="/docs/_astro/layout.B0yR2uG_.js" component-export="SetLayout" renderer-url="/docs/_astro/client.6CXocn7l.js" props="{&quot;value&quot;:[0,&quot;guide&quot;]}" ssr client="idle" opts="{&quot;name&quot;:&quot;SetLayout&quot;,&quot;value&quot;:true}"></astro-island><article class="w-content-width max-w-full mx-auto"><header class="my-8 space-y-2"><astro-island uid="2ufwlc" prefix="r17" component-url="/docs/_astro/PageHeaderIsland.Dgde9s7h.js" component-export="default" renderer-url="/docs/_astro/client.6CXocn7l.js" props="{&quot;alwaysShowTags&quot;:[0,true],&quot;outerHeader&quot;:[0,true],&quot;title&quot;:[0,&quot;Can I publish the content I generate on the platform?&quot;],&quot;titleCode&quot;:[0],&quot;titleIconFallback&quot;:[0],&quot;subtitle&quot;:[0],&quot;subtitleCode&quot;:[0],&quot;subtitleIconFallback&quot;:[0],&quot;breadcrumb&quot;:[1,[[0,{&quot;title&quot;:[0,&quot;Legal&quot;],&quot;pointsTo&quot;:[0,&quot;docs/help-center/legal&quot;]}]]],&quot;domain&quot;:[0,&quot;elevenlabs.io&quot;],&quot;slug&quot;:[0,&quot;docs/help-center/legal/can-i-publish-the-content-i-generate-on-the-platform&quot;],&quot;lang&quot;:[0,&quot;en&quot;],&quot;basepath&quot;:[0,&quot;/docs&quot;],&quot;currentLocale&quot;:[0],&quot;markdown&quot;:[0,&quot;---\n\n## title: Can I publish the content I generate on the platform?\n\nThe free plan does &lt;strong&gt;not&lt;/strong&gt; include a commercial license and cannot be used for any commercial purpose. If you publish content generated using our Services on a free plan or without being signed-in to your account, you must attribute it to ElevenLabs by including \&quot;elevenlabs.io\&quot; or \&quot;11.ai\&quot; in the title (except in the case where your content is generated using Eleven Music on a free plan or without being signed-in to your account, you must attribute it to ElevenLabs by referencing \&quot;Eleven Music\&quot; when distributing such content).\n\nAll paid plans include a commercial license, provided you&#39;re not using Beta Services. As long as you hold the necessary intellectual property rights to your generated content, and it complies with applicable laws, our [Terms of Service](https://elevenlabs.io/terms) and [Prohibited Use Policy](https://elevenlabs.io/use-policy), you may use it commercially.\n\nSome products and features may have additional terms and conditions. Consult our [Service-Specific Terms](https://elevenlabs.io/service-specific-terms) before commercial use. Attribution requirement is subject to the agreement you have with ElevenLabs.\n\nFor full details, refer to our [Terms of Service](https://elevenlabs.io/terms).\n\nIn summary:\n\n* Content generated during a paid subscription can be used commercially, and indefinitely, subject to our [Service-Specific Terms](https://elevenlabs.io/service-specific-terms). Attribution requirement is subject to the agreement you have with ElevenLabs.\n* Content created outside of a paid subscription (before or after) cannot be used commercially and always requires attribution when shared non-commercially.\n* Under our [Beta Services Addendum](https://elevenlabs.io/bsa), content generated using Beta Services cannot be used for any commercial purpose or in any production environment.\n&quot;],&quot;perViewerCopy&quot;:[0,true],&quot;askAiEnabled&quot;:[0,false],&quot;skillsConfig&quot;:[0],&quot;availability&quot;:[0],&quot;pageActions&quot;:[0,{&quot;options&quot;:[0,{&quot;copyPage&quot;:[0,true],&quot;viewAsMarkdown&quot;:[0,true],&quot;askAi&quot;:[0,true],&quot;openAi&quot;:[0,true],&quot;claude&quot;:[0,true],&quot;cursor&quot;:[0,true],&quot;claudeCode&quot;:[0,true],&quot;vscode&quot;:[0,false],&quot;custom&quot;:[1,[[0,{&quot;title&quot;:[0,&quot;LLMs index&quot;],&quot;subtitle&quot;:[0,&quot;See an index of the documentation as markdown for LLMs&quot;],&quot;url&quot;:[0,&quot;https://elevenlabs.io/docs/llms.txt&quot;],&quot;icon&quot;:[0,&quot;fa-solid fa-file-code&quot;]}]]]}]}],&quot;pageActionsStyle&quot;:[0,&quot;default&quot;],&quot;pageActionFiles&quot;:[0],&quot;showRssFeedButton&quot;:[0,false],&quot;showPageActions&quot;:[0,true]}" ssr client="deferred" opts="{&quot;name&quot;:&quot;PageHeaderIsland&quot;,&quot;value&quot;:true}" await-children><!--$--><div class="space-y-2"><div class="flex justify-between"><span class="fern-breadcrumb"><a data-astro-prefetch="viewport" class="fern-breadcrumb-item" href="/docs/help-center/legal">Legal</a></span></div><div class="flex flex-row items-center justify-between gap-2"><div class="flex flex-row items-center gap-4"><div class="flex flex-row items-center" data-fern-style="gap:8px"><h1 class="fern-page-heading text-balance wrap-anywhere">Can I publish the content I generate on the platform?</h1></div><span class="inline-flex items-center gap-2"></span></div><div class="hidden md:flex"><div class="fern-page-actions"><button tabindex="0" data-state="off" aria-disabled="false" class="w-fit px-2 rounded-r-none fern-button minimal normal"><span class="fern-button-content"><span class="fern-button-text"><div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy size-icon animate-in fade-in duration-200"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg><span class="animate-in fade-in duration-300">Copy page</span></div></span></span></button><button tabindex="0" data-state="off" aria-disabled="false" class="group rounded-l-none px-2 fern-button minimal normal"><span class="fern-button-content"><span class="fern-button-text"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down size-icon animate-dropdown-chevron"><path d="m6 9 6 6 6-6"></path></svg></span></span></button></div></div></div></div><!--/$--><!--astro:end--></astro-island></header><div class="fern-prose prose break-words prose-h1:mt-[1.5em] first:prose-h1:mt-0 max-w-full"><!--$--><div data-fern-style="display:contents"><p>The free plan does <strong class="font-semibold">not</strong> include a commercial license and cannot be used for any commercial purpose. If you publish content generated using our Services on a free plan or without being signed-in to your account, you must attribute it to ElevenLabs by including “elevenlabs.io” or “11.ai” in the title (except in the case where your content is generated using Eleven Music on a free plan or without being signed-in to your account, you must attribute it to ElevenLabs by referencing “Eleven Music” when distributing such content).</p>
<p>All paid plans include a commercial license, provided you’re not using Beta Services. As long as you hold the necessary intellectual property rights to your generated content, and it complies with applicable laws, our <a class="fern-mdx-link" href="https://elevenlabs.io/terms">Terms of Service</a> and <a class="fern-mdx-link" href="https://elevenlabs.io/use-policy">Prohibited Use Policy</a>, you may use it commercially.</p>
<p>Some products and features may have additional terms and conditions. Consult our <a class="fern-mdx-link" href="https://elevenlabs.io/service-specific-terms">Service-Specific Terms</a> before commercial use. Attribution requirement is subject to the agreement you have with ElevenLabs.</p>
<p>For full details, refer to our <a class="fern-mdx-link" href="https://elevenlabs.io/terms">Terms of Service</a>.</p>
<p>In summary:</p>
<ul class="[&amp;&gt;li]:relative [&amp;&gt;li]:before:text-(color:--grayscale-a10) mb-3 list-none pl-3 [&amp;&gt;li]:pl-3 [&amp;&gt;li]:before:absolute [&amp;&gt;li]:before:ml-[-22px] [&amp;&gt;li]:before:mt-[-1px] [&amp;&gt;li]:before:content-[&#x27;⦁&#x27;] [&amp;&gt;li]:before:self-center">
<li class="">Content generated during a paid subscription can be used commercially, and indefinitely, subject to our <a class="fern-mdx-link" href="https://elevenlabs.io/service-specific-terms">Service-Specific Terms</a>. Attribution requirement is subject to the agreement you have with ElevenLabs.</li>
<li class="">Content created outside of a paid subscription (before or after) cannot be used commercially and always requires attribution when shared non-commercially.</li>
<li class="">Under our <a class="fern-mdx-link" href="https://elevenlabs.io/bsa">Beta Services Addendum</a>, content generated using Beta Services cannot be used for any commercial purpose or in any production environment.</li>
</ul></div><!--/$--></div></article><div class="grow"></div><div class="contents"><div class="contents"><script>(function(){function e(){let e=globalThis.scheduler;return typeof e?.yield==`function`?e.yield():new Promise(e=>setTimeout(e,0))}function t(t,n,r){let i=!1,a=()=>{i||(i=!0,t().then(async t=>{await e(),await t()}))};if(document.documentElement.hasAttribute(`data-fern-hydrate-all`)){typeof window.requestIdleCallback==`function`?window.requestIdleCallback(a,{timeout:2e3}):window.setTimeout(a,200);return}let o=typeof n.value==`object`?n.value:void 0,s=new IntersectionObserver(e=>{for(let t of e)if(t.isIntersecting){s.disconnect(),a();break}},{rootMargin:o?.rootMargin});for(let e of r.children)s.observe(e)}(self.Astro||(self.Astro={})).lazy=t,window.dispatchEvent(new Event(`astro:lazy`))})();</script><astro-island uid="Z2sTDpr" prefix="r18" component-url="/docs/_astro/FooterIsland.BVsiH_vu.js" component-export="default" renderer-url="/docs/_astro/client.6CXocn7l.js" props="{&quot;lang&quot;:[0,&quot;en&quot;],&quot;pathname&quot;:[0,&quot;/docs/help-center/legal/can-i-publish-the-content-i-generate-on-the-platform&quot;],&quot;basepath&quot;:[0,&quot;/docs&quot;],&quot;domain&quot;:[0,&quot;elevenlabs.io&quot;],&quot;currentLocale&quot;:[0],&quot;editThisPageUrl&quot;:[0],&quot;editThisPageLaunch&quot;:[0],&quot;docsUrl&quot;:[0,&quot;elevenlabs.io/docs&quot;],&quot;slug&quot;:[0,&quot;docs/help-center/legal/can-i-publish-the-content-i-generate-on-the-platform&quot;],&quot;orgName&quot;:[0,&quot;elevenlabs&quot;],&quot;footerNavStyle&quot;:[0,&quot;default&quot;],&quot;workerNeighborSlots&quot;:[0,true],&quot;changelogPager&quot;:[0,false],&quot;hideFeedback&quot;:[0,false],&quot;hideNavLinks&quot;:[0,false],&quot;hasMultipleLanguages&quot;:[0,true],&quot;lastUpdated&quot;:[0],&quot;footerLinks&quot;:[1,[]],&quot;hideBuiltWithFern&quot;:[0,false],&quot;className&quot;:[0],&quot;showFeedback&quot;:[0,true],&quot;prev&quot;:[0,{&quot;title&quot;:[0,&quot;Legal an