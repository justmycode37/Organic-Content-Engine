age-section-pb)] [--section-bleed-x:var(--page-section-px)] [--page-section-px:var(--section-px-none)] [--page-section-pb:var(--section-py-md)] [--page-section-pt:var(--section-py-none)] [--full-bleed-section:calc(var(--page-section-px)+var(--container-full-bleed,0px))] [--full-bleed:var(--full-bleed-section)] [--edge-bleed:var(--spacing-gutter)] [--edge-inset:0px]"><div class="block-el block-el-title tw-pt-[var(--hero-pt)]"><div class="-tw-mx-section-bleed-x tw-grid tw-grid-cols tw-gap-x tw-px-gutter"><div class="-tw-mx-edge-bleed tw-px-edge-inset tw-col-span-full sm:tw-col-span-10 sm:tw-col-start-2 sm:tw-mx-0 sm:tw-px-inset lg:tw-col-span-8 lg:tw-col-start-3"><h1 class="tw-block tw-text-black tw-type-6xl tw-text-balance tw-text-center">Service-Specific Terms</h1></div></div><div class="tracker-contextual-nav -tw-mt-0.25 tw-h-0.25 tw-w-full"></div></div></div></div></div><div class="tracker-contextual-nav -tw-mt-0.25 tw-h-0.25 tw-w-full"></div><div class="block-section" style="--marker-background-color:#FDFCFC"><div class="tw-relative tw-container"><div class="tw-px-[var(--page-section-px)] tw-pt-[var(--page-section-pt)] tw-pb-[var(--page-section-pb)] [--section-bleed-x:var(--page-section-px)] [--page-section-px:var(--section-px-none)] [--page-section-pb:var(--section-py-sm)] [--page-section-pt:var(--section-py-none)] [--full-bleed-section:calc(var(--page-section-px)+var(--container-full-bleed,0px))] [--full-bleed:var(--full-bleed-section)] [--edge-bleed:var(--spacing-gutter)] [--edge-inset:0px]"><div class="tw-max-w-3xl tw-mx-auto"><audio preload="none" style="display:none" aria-hidden="true" crossorigin="anonymous"></audio><div style="--em:var(--tw-font-size-lg);--lh:var(--tw-line-height-lg-loose, var(--tw-line-height-lg));--trim-top:var(--tw-trim-top-lg-loose, var(--tw-trim-top-lg));--trim-bottom:var(--tw-trim-bottom-lg-loose, var(--tw-trim-bottom-lg))" class="typography typography-loose typography-headings"><p class="content-element">Last Updated: 09 October 2026</p><p class="content-element">PLEASE READ THESE SERVICE-SPECIFIC TERMS CAREFULLY. </p><p class="content-element">These ElevenLabs Service-Specific Terms (“<span style="font-weight:bold">Service-Specific Terms</span>”) are intended to highlight some of the important things about using our different Services. The Service-Specific Terms supplement your existing agreement with ElevenLabs or, if no separate agreement exists, the <a href="/terms-of-use" class="content-element">ElevenLabs Terms of Service</a>. </p><p class="content-element">If you are using any of the Services described below, the terms corresponding to those Services(s) also apply to your access and use. We update this page from time to time by posting a revised copy at <a href="https://elevenlabs.io/service-specific-terms" target="_self">https://elevenlabs.io/service-specific-terms</a>, so please check back here for the most up-to-date information. </p><p class="content-element">Please see below for the current Service-Specific Terms:</p><ul class="content-element"><li class="content-element" value="1"><a href="/agents-terms" class="content-element">ElevenAgents Terms</a></li><li class="content-element" value="2"><a href="/creative-terms" class="content-element">ElevenCreative Terms</a></li><li class="content-element" value="3"><a href="/elevenapi-terms" class="content-element">ElevenAPI Terms</a></li><li class="content-element" value="4"><a href="/music-terms" class="content-element">Music Terms</a></li><li class="content-element" value="5"><a href="/speech-to-text-terms" class="content-element">ElevenLabs Speech to Text Terms</a></li><li class="content-element" value="6"><a href="/productions-terms" class="content-element">Productions Terms</a></li></ul></div></div></div></div></div><div aria-hidden="true" class="tw-absolute tw-inset-x-0 tw-bottom-[50vh] tw-h-0.25 tw-w-full"></div></div></div></div><!--$!--><template data-dgst></template><!--/$--><div class="tw-border-y tw-border-black/5 tw-mt-[3.75