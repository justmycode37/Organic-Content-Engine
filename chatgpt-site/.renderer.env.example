# For the always-on render worker, never for the frontend bundle.
OCE_SITE_URL=https://your-existing-site.chatgpt.site
OCE_RENDER_TOKEN=                  # matches RENDER_WORKER_TOKEN on the Site
# JOB_TOKEN is a supported fallback for older worker installations.
# Private Sites: existing service-access bearer token, sent only to this Site.
OCE_SITES_ACCESS_TOKEN=
# macOS default: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Docker default: /usr/bin/chromium
CHROME_PATH=
