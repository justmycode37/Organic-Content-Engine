{
  "name": "organic-content-engine-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "validate": "node scripts/validate-artifact.mjs",
    "test": "node --test scripts/smoke.mjs",
    "check": "npm run typecheck && npm run build && npm run validate && npm test",
    "db:generate": "drizzle-kit generate",
    "db:local": "wrangler d1 execute DB --local --config wrangler.local.jsonc --persist-to .wrangler/state --file drizzle/0000_initial.sql",
    "dev:local": "wrangler dev --config wrangler.local.jsonc --persist-to .wrangler/state --ip 127.0.0.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "hono": "4.13.17",
    "lucide-react": "0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "wrangler": "4.92.0"
  }
}
