# Configure these as Site runtime values/secrets. Never put real values in source.
OWNER_USER_ID=
APP_PASSWORD_HASH=                 # secret: salt:PBKDF2-SHA256 (100,000 rounds), hex output
SESSION_SECRET=                    # secret: high entropy signing key
TOKEN_ENCRYPTION_KEY=              # secret: base64-encoded 32-byte AES-GCM key
PUBLIC_BASE_URL=                   # https://<this-site>.chatgpt.site
JOB_TOKEN=                         # secret, min 32 chars; optional machine job calls
SITES_SERVICE_ACCESS_TRUSTED=       # true only for an owner-private Site
PUBLISH_MODE=                      # dry_run or live
PUBLISH_HTTP_TIMEOUT_MS=
CONTENT_GENERATOR=                 # chatgpt-plan (default); no model API key required

# One-time developer application setup. Social account authorization happens in Platforms.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=           # secret
INSTAGRAM_API_VERSION=             # default v25.0
TIKTOK_CLIENT_ID=                   # TikTok client key
TIKTOK_CLIENT_SECRET=              # secret
YOUTUBE_CLIENT_ID=                 # Google OAuth web client; enable YouTube Data API
YOUTUBE_CLIENT_SECRET=             # secret
X_CLIENT_ID=
X_CLIENT_SECRET=                   # secret
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=            # secret
LINKEDIN_API_VERSION=              # required YYYYMM, keep current as versions retire

# Optional legacy text publishing configuration; browser account connections take precedence.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
X_USER_ACCESS_TOKEN=

# Optional operator-owned publishing gateway override.
PUBLISHING_GATEWAY_URL=
PUBLISHING_GATEWAY_TOKEN=
PUBLISHING_GATEWAY_PLATFORMS=
