# Names only. Configure hosted values as Site runtime values and secrets, never in source.

# Access
OWNER_USER_ID=                 # optional: pin the owner instead of first-visitor claim
JOB_TOKEN=                     # min 32 chars; bearer token for POST /api/jobs/tick
SITES_SERVICE_ACCESS_TRUSTED=  # "true" only while the Site is confirmed owner-private

# Publishing
PUBLISH_MODE=                  # dry_run (default) or live
PUBLISH_HTTP_TIMEOUT_MS=

# Generation
CONTENT_GENERATOR=             # template (default) or anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Direct adapters (text only, mock-tested, never run against a live account)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_SERVICE_URL=
MASTODON_INSTANCE_URL=
MASTODON_ACCESS_TOKEN=
MASTODON_MAX_CHARS=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_API_VERSION=
X_USER_ACCESS_TOKEN=

# External gateway (required for Threads, Facebook, Instagram, TikTok, YouTube, Pinterest)
PUBLISHING_GATEWAY_URL=
PUBLISHING_GATEWAY_TOKEN=
PUBLISHING_GATEWAY_PLATFORMS=
